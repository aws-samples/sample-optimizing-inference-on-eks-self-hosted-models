# Version pins of the sample: plain KEY=value lines, no quotes, spaces or $. RUNTIME_IMAGE is the public NGC image
# that the Frontend and the SGLang workers run, pinned by digest; terraform/cluster/terraform.tfvars.example and
# manifests/config/platform.env.example carry the same value. DYNAMO_OPERATOR_CHART_VERSION equals the dynamo_version
# default of terraform/cluster. The recorded results were measured with a derived SGLang 0.5.22 build (see README.md).
RUNTIME_IMAGE=nvcr.io/nvidia/ai-dynamo/sglang-runtime:1.6.0-efa@sha256:d574951b0dbd037bdcaabe121431a83cd047a5c106cb243fe6f2f97f2e456cd2
DYNAMO_RUNTIME_VERSION=1.6.0
SGLANG_VERSION=0.5.21
NIXL_VERSION=1.5.0
EFA_INSTALLER_VERSION=1.50.0
DYNAMO_OPERATOR_CHART_VERSION=1.5.1
