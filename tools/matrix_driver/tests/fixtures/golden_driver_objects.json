            ]
           }
          },
          "volumeMounts": [
           {
            "mountPath": "/etc/q38/watchdog",
            "name": "watchdog",
            "readOnly": true
           }
          ]
         }
        ],
        "nodeSelector": {
         "karpenter.sh/nodepool": "gpu-b200-cb"
        },
        "restartPolicy": "Never",
        "securityContext": {
         "runAsGroup": 10001,
         "runAsNonRoot": true,
         "runAsUser": 10001,
         "seccompProfile": {
          "type": "RuntimeDefault"
         }
        },
        "serviceAccountName": "matrix-driver",
        "tolerations": [
         {
          "effect": "NoSchedule",
          "key": "nvidia.com/gpu",
          "operator": "Exists"
         }
        ],
        "volumes": [
         {
          "configMap": {
           "name": "q38-matrix-watchdog"
          },
          "name": "watchdog"
         }
        ]
       }
      },
      "ttlSecondsAfterFinished": 172800
     }
    },
    "schedule": "*/5 4,9 24 10 *",
    "startingDeadlineSeconds": 120,
    "successfulJobsHistoryLimit": 6,
    "timeZone": "Etc/UTC"
   }
  }
