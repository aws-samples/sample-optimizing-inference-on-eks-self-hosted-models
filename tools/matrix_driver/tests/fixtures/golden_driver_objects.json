 "preflight": [
  {
   "binary_keys": [],
   "data_keys": [
    "capture.py",
    "compose.sh"
   ],
   "kind": "ConfigMap",
   "metadata": {
    "labels": {
     "app.kubernetes.io/name": "q38-matrix-driver",
     "app.kubernetes.io/part-of": "qwen38-matrix"
    },
    "name": "q38-take-capture",
    "namespace": "bench"
   }
  },
  {
   "apiVersion": "batch/v1",
   "kind": "Job",
   "metadata": {
    "labels": {
     "app.kubernetes.io/name": "take-preflight",
     "app.kubernetes.io/part-of": "qwen38-matrix",
     "q38-matrix/run-id": "q38-e7"
    },
    "name": "q38-take-preflight-q38-e7",
    "namespace": "bench"
   },
   "spec": {
    "activeDeadlineSeconds": 900,
    "backoffLimit": 0,
    "template": {
     "metadata": {
      "labels": {
       "app.kubernetes.io/name": "take-preflight",
       "app.kubernetes.io/part-of": "qwen38-matrix",
       "q38-matrix/run-id": "q38-e7"
      }
     },
     "spec": {
      "containers": [
       {
        "args": [
         "set -euo pipefail\npython3 -m pip install --user --no-cache-dir --disable-pip-version-check --quiet playwright==1.64.0 boto3==1.43.116\nexec python3 /capture/capture.py\n"
        ],
        "command": [
         "/bin/bash",
         "-c"
        ],
        "env": [
         {
          "name": "HOME",
          "value": "/home/pwuser"
         },
         {
          "name": "PIP_BREAK_SYSTEM_PACKAGES",
          "value": "1"
         },
         {
          "name": "CHECK_ONLY",
          "value": "1"
         },
         {
          "name": "TAKE_ID",
          "value": "preflight"
         },
         {
          "name": "CHECK_NAMESPACES",
          "value": "s-agg,s-dis-hic"
         },
         {
          "name": "GRAFANA_URL",
          "value": "http://prometheus-grafana.monitoring.svc.cluster.local"
         },
         {
          "name": "GRAFANA_USER",
          "value": "admin"
         },
         {
          "name": "GRAFANA_PASSWORD",
          "valueFrom": {
           "secretKeyRef": {
            "key": "password",
            "name": "demo-grafana-auth"
           }
          }
         },
         {
          "name": "DASHBOARD_UID",
          "value": "demo-take"
         },
         {
          "name": "OUT_DIR",
          "value": "/out"
         },
         {
          "name": "S3_PREFIX",
          "value": "takes/q38-e7/_preflight"
         },
         {
          "name": "RESULTS_BUCKET",
          "value": "${RESULTS_BUCKET}"
         },
         {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
         },
         {
          "name": "AWS_DEFAULT_REGION",
          "value": "${AWS_REGION}"
         }
        ],
        "image": "mcr.microsoft.com/playwright/python:v1.64.0-noble@sha256:684df257a1fa0ef3fa288239819984008f560e8f8db5b635ee9e2a50cbcd2e23",
        "imagePullPolicy": "IfNotPresent",
        "name": "capture",
        "resources": {
         "limits": {
          "cpu": "3",
          "memory": "6Gi"
         },
         "requests": {
          "cpu": "1",
          "memory": "3Gi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         }
        },
        "volumeMounts": [
         {
          "mountPath": "/capture",
          "name": "capture-script",
          "readOnly": true
         },
         {
          "mountPath": "/dev/shm",
          "name": "dshm"
         },
         {
          "mountPath": "/out",
          "name": "out"
         }
        ]
       }
      ],
      "initContainers": [
       {
        "command": [
         "/bin/bash",
         "-c",
         "set -euo pipefail\naws --version\njq --version\nstat --version >/dev/null\n"
        ],
        "env": [
         {
          "name": "HOME",
          "value": "/tmp"
         }
        ],
        "image": "public.ecr.aws/aws-cli/aws-cli:2.38.1@sha256:733d5be1015825e4038c6016f3fa9954868ddee1f611b73be795a9cc2e706bfd",
        "imagePullPolicy": "IfNotPresent",
        "name": "aws-cli",
        "resources": {
         "limits": {
          "memory": "1Gi"
         },
         "requests": {
          "cpu": "100m",
          "memory": "256Mi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         }
        }
       },
       {
        "command": [
         "/bin/bash",
         "-c",
         "set -euo pipefail\nv=\"$(ffmpeg -hide_banner -version)\"; echo \"${v%%$'\\n'*}\"\nf=\"$(ffmpeg -hide_banner -filters)\"; for x in drawtext hstack vstack tpad trim; do grep -q \" $x \" <<<\"$f\"; done\ne=\"$(ffmpeg -hide_banner -encoders)\"; grep -q libx264 <<<\"$e\"\ntest -s /usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf\njq --version\necho ffmpeg-ok\n"
        ],
        "env": [
         {
          "name": "HOME",
          "value": "/tmp"
         }
        ],
        "image": "${FFMPEG_IMAGE}",
        "imagePullPolicy": "IfNotPresent",
        "name": "ffmpeg",
        "resources": {
         "limits": {
          "memory": "1Gi"
         },
         "requests": {
          "cpu": "100m",
          "memory": "256Mi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         }
        }
       }
      ],
      "nodeSelector": {
       "karpenter.sh/nodepool": "cpu-demo"
      },
      "restartPolicy": "Never",
      "securityContext": {
       "fsGroup": 1001,
       "runAsGroup": 1001,
       "runAsNonRoot": true,
       "runAsUser": 1001,
       "seccompProfile": {
        "type": "RuntimeDefault"
       }
      },
      "serviceAccountName": "matrix-driver",
      "terminationGracePeriodSeconds": 10,
      "volumes": [
       {
        "configMap": {
         "name": "q38-take-capture"
        },
        "name": "capture-script"
       },
       {
        "emptyDir": {
         "medium": "Memory",
         "sizeLimit": "1Gi"
        },
        "name": "dshm"
       },
       {
        "emptyDir": {
         "sizeLimit": "8Gi"
        },
        "name": "out"
       }
      ]
     }
    },
    "ttlSecondsAfterFinished": 86400
   }
  }
