 "job_e7": [
  {
   "apiVersion": "batch/v1",
   "kind": "Job",
   "metadata": {
    "annotations": {
     "q38-matrix/hard-stop": "2026-10-24T09:00:00Z",
     "q38-matrix/rendered-at": "2026-10-23T22:00:00Z"
    },
    "labels": {
     "app.kubernetes.io/name": "q38-matrix-driver",
     "app.kubernetes.io/part-of": "qwen38-matrix",
     "q38-matrix/plan": "plan-e7"
    },
    "name": "q38-matrix-e7",
    "namespace": "bench"
   },
   "spec": {
    "activeDeadlineSeconds": 39600,
    "backoffLimit": 0,
    "completions": 1,
    "parallelism": 1,
    "template": {
     "metadata": {
      "annotations": {
       "karpenter.sh/do-not-disrupt": "true"
      },
      "labels": {
       "app.kubernetes.io/name": "q38-matrix-driver",
       "app.kubernetes.io/part-of": "qwen38-matrix",
       "q38-matrix/plan": "plan-e7"
      }
     },
     "spec": {
      "containers": [
       {
        "args": [
         "--plan",
         "/etc/q38/plans/plan-e7.txt"
        ],
        "command": [
         "python3",
         "-I",
         "/etc/q38/driver/matrix_driver.py"
        ],
        "env": [
         {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
         },
         {
          "name": "AWS_DEFAULT_REGION",
          "value": "${AWS_REGION}"
         },
         {
          "name": "RESULTS_BUCKET",
          "value": "${RESULTS_BUCKET}"
         },
         {
          "name": "WORK",
          "value": "/work"
         },
         {
          "name": "DGD_DIR",
          "value": "/etc/q38/dgds"
         },
         {
          "name": "DRIVER_DIR",
          "value": "/etc/q38/driver"
         },
         {
          "name": "CB_NODE",
          "value": "${CB_NODE}"
         },
         {
          "name": "HARD_STOP",
          "value": "2026-10-24T09:00:00Z"
         },
         {
          "name": "JOB_NAME",
          "valueFrom": {
           "fieldRef": {
            "fieldPath": "metadata.labels['batch.kubernetes.io/job-name']"
           }
          }
         },
         {
          "name": "L3_CLEANUP_IMAGE",
          "value": "${RUNTIME_IMAGE}"
         },
         {
          "name": "L3_ROOT",
          "value": "/mnt/.ephemeral/hicache-l3/qwen38-matrix"
         },
         {
          "name": "PROMETHEUS_URL",
          "value": "http://prometheus-kube-prometheus-prometheus.monitoring.svc:9090"
         },
         {
          "name": "GRAFANA_URL",
          "value": "http://prometheus-grafana.monitoring.svc.cluster.local"
         },
         {
          "name": "COMPOSE_FFMPEG_IMAGE",
          "value": "${FFMPEG_IMAGE}"
         },
         {
          "name": "HOME",
          "value": "/work/home"
         },
         {
          "name": "HF_HUB_OFFLINE",
          "value": "1"
         },
         {
          "name": "TRANSFORMERS_OFFLINE",
          "value": "1"
         }
        ],
        "image": "${BENCH_IMAGE}",
        "imagePullPolicy": "IfNotPresent",
        "name": "driver",
        "resources": {
         "limits": {
          "cpu": "8",
          "memory": "32Gi"
         },
         "requests": {
          "cpu": "4",
          "memory": "16Gi"
         }
        },
        "securityContext": {
         "allowPrivilegeEscalation": false,
         "capabilities": {
          "drop": [
           "ALL"
          ]
         }
        },
        "volumeMounts": [
         {
          "mountPath": "/etc/q38/driver",
          "name": "driver",
          "readOnly": true
         },
         {
          "mountPath": "/etc/q38/dgds",
          "name": "dgds",
          "readOnly": true
         },
         {
          "mountPath": "/etc/q38/plans",
          "name": "plans",
          "readOnly": true
         },
         {
          "mountPath": "/work",
          "name": "work"
         }
        ]
       }
      ],
      "nodeSelector": {
       "karpenter.sh/nodepool": "gpu-b200-cb"
      },
      "restartPolicy": "Never",
      "securityContext": {
       "fsGroup": 10001,
       "runAsGroup": 10001,
       "runAsNonRoot": true,
       "runAsUser": 10001,
       "seccompProfile": {
        "type": "RuntimeDefault"
       }
      },
      "serviceAccountName": "matrix-driver",
      "terminationGracePeriodSeconds": 600,
      "tolerations": [
       {
        "effect": "NoSchedule",
        "key": "nvidia.com/gpu",
        "operator": "Exists"
       }
      ],
      "volumes": [
       {
        "configMap": {
         "name": "q38-matrix-driver"
        },
        "name": "driver"
       },
       {
        "configMap": {
         "name": "q38-matrix-dgds"
        },
        "name": "dgds"
       },
       {
        "configMap": {
         "name": "q38-matrix-plans"
        },
        "name": "plans"
       },
       {
        "emptyDir": {
         "sizeLimit": "40Gi"
        },
        "name": "work"
       }
      ]
     }
    },
    "ttlSecondsAfterFinished": 172800
   }
  }
 ],
