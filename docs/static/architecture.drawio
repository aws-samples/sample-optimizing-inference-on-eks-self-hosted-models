        <mxCell id="legend-title" value="&lt;b&gt;How the demo runs&lt;/b&gt;" style="text;html=1;fontFamily=Helvetica;fontSize=16;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1344" y="98" width="242" height="26" as="geometry" /></mxCell>
        <mxCell id="lg-b1" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="131" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t1" value="The driver Job applies the S0 or S7 DynamoGraphDeployment; the Dynamo operator creates the pods." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="130" width="212" height="52" as="geometry" /></mxCell>
        <mxCell id="lg-b2" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="188" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t2" value="Runtime image from NVIDIA NGC (or an ECR copy), bench image from ECR; weights prefetched from S3." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="187" width="212" height="52" as="geometry" /></mxCell>
        <mxCell id="lg-b3" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="245" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t3" value="aiperf replays the W3-16K trace at 25 req/s against the Frontend; results go to S3." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="244" width="212" height="52" as="geometry" /></mxCell>
        <mxCell id="lg-b4" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="302" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t4" value="S0: round-robin over 8 aggregated workers; KV only in GPU HBM." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="301" width="212" height="36" as="geometry" /></mxCell>
        <mxCell id="lg-b5" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="343" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t5" value="S7: the KV router picks the prefill worker that holds the prefix (R); HiCache keeps KV in host RAM and on local NVMe (O)." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="342" width="212" height="70" as="geometry" /></mxCell>
        <mxCell id="lg-b6" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="418" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t6" value="Prefill hands the KV to decode over NIXL LIBFABRIC on EFA (D)." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="417" width="212" height="36" as="geometry" /></mxCell>
        <mxCell id="lg-b7" value="&lt;b&gt;7&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fontFamily=Helvetica;fontSize=13;fontColor=#FFFFFF;fillColor=#007D7A;strokeColor=#FFFFFF;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1342" y="459" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="lg-t7" value="Prometheus scrapes the Frontend and SGLang pods and DCGM; Grafana draws the take view." style="text;html=1;fontFamily=Helvetica;fontSize=13;fontColor=light-dark(#232F3E,#FFFFFF);align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;spacing=0;" vertex="1" parent="1"><mxGeometry x="1372" y="458" width="212" height="52" as="geometry" /></mxCell>
