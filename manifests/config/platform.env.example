# Reference copy of platform.env, the platform config read by scripts/lib/common.sh.
# The real platform.env next to this file is GENERATED by scripts/gen_env.py from the terraform/cluster
# outputs and gitignored (it holds account values). Format: plain KEY=VALUE, no quotes, spaces or $;
# keys match ^[A-Z][A-Z0-9_]*$ (scripts/lib/common.sh stops on any other key and never evaluates the file).
# The values below are placeholders (account 123456789012, project dynamo-sample) that the generator
# replaces with your outputs.
# This is the tested shape (one pool gpu-b200-cb, p6-b200.48xlarge, Capacity Block).
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-2
CLUSTER_NAME=dynamo-sample-use2
EFA_INTERFACES_PER_NODE=8
EPHEMERAL_MIN_GIB=28312
GPUS_PER_NODE=8
GPU_AZ=us-east-2a
GPU_CAPACITY_TYPE=capacity-block
GPU_INSTANCE_TYPES=p6-b200.48xlarge
GPU_MEMORY_GIB_PER_GPU=179
GPU_NODEPOOL=gpu-b200-cb
GPU_POOLS=gpu-b200-cb:8:8
GPU_PRODUCT=NVIDIA-B200
GRAFANA_EDGE_ENABLED=false
HOST_MEMORY_GIB=2048
MODEL_BUCKET=dynamo-sample-models-123456789012-use2
MODEL_ID=Qwen/Qwen3.8-27B-FP8
MODEL_REVISION=017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
MODEL_S3_PREFIX=Qwen/Qwen3.8-27B-FP8/017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
MODEL_S3_URI=s3://dynamo-sample-models-123456789012-use2/Qwen/Qwen3.8-27B-FP8/017b9c7af6b5689d5dd426a76e0bc077eb5ca20a
PRIMARY_AZ=us-east-2a
RESULTS_BUCKET=dynamo-sample-results-123456789012-use2
RUNTIME_IMAGE=nvcr.io/nvidia/ai-dynamo/sglang-runtime:1.6.1-efa@sha256:bc30725d441e32406f2ee237bb3f0b720b105ca3b7f0c43b3d68918a23a5a954
# Never in this file: HF_TOKEN (optional, gated models only; scripts/lib/common.sh reads every key
# here). Export it in the shell that runs scripts/stage-model.sh, which reads it from the
# process environment only and hands it to the cluster as an ephemeral Secret. gen_env.py never writes it.
