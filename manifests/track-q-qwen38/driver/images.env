# Matrix driver image pins (tag + digest). The repository part (registry host, account, region) is
# BENCH_REPO of the platform.env given to tools/matrix_driver/render_driver.py (--env), which joins them as
# <BENCH_REPO>:<TAG>@<DIGEST>. Same format as platform.env: plain KEY=VALUE, no quotes, spaces or $.
# Driver + watchdog image: the bench image the runs of record used.
MATRIX_BENCH_TAG=1517a23
MATRIX_BENCH_DIGEST=sha256:ff31929ce363efec1d24f603cee4ae47c5fc44374a6ec1d397cc25697750637a
# Compose render leg: linuxserver/ffmpeg 9.0.2-cli-ls86 mirrored into BENCH_REPO (index digest preserved).
MATRIX_FFMPEG_TAG=ffmpeg-9.0.2-cli-ls86
MATRIX_FFMPEG_DIGEST=sha256:742e17516dd4d7b76b939d774bd08f0f6b7cab8bce1c014b95ab2fb992fd0a1f
