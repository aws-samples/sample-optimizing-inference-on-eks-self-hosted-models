# Local tooling state and caches
.DS_Store
.omc/
.venv/
__pycache__/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
dist/

# Terraform state, providers and local variable files
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Local secrets (never commit)
.env
.env.*
!.env.example

# Generated by scripts/gen_env.py from the terraform/cluster outputs (account values; the
# committed reference is manifests/config/platform.env.example)
/manifests/config/platform.env
/config/sample.env
